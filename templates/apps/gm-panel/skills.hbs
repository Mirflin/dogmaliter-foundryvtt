{{!-- GM panel, Skills page: module/apps/gm-panel.mjs, skills from the world's
      "Навыки" compendium (module/rules/skills.mjs). The form's fields carry
      data-draft (the path in the draft); the list filters by search and tag
      without a redraw; a row drags onto a character sheet. --}}
<section class="dl-tab {{#if active}}active{{/if}}" data-tab="skills">

  <details class="dl-card dl-skill-form" data-sync="skillForm" {{#if draft.editing}}open{{/if}}>
    <summary class="dl-card-title">
      <i class="fa-solid {{#if draft.editing}}fa-pen{{else}}fa-plus{{/if}}" inert></i>
      {{#if draft.editing}}{{localize 'DOGMALITER.Skills.EditTitle'}}{{else}}{{localize 'DOGMALITER.Skills.NewTitle'}}{{/if}}
    </summary>

    <div class="dl-row">
      <button type="button" class="dl-skill-img-pick" data-action="skillImgPick"
              data-tooltip="{{localize 'DOGMALITER.Skills.PickImage'}}" aria-label="{{localize 'DOGMALITER.Skills.PickImage'}}">
        <img src="{{draft.img}}" alt=""/>
      </button>
      <span class="dl-label">{{localize 'DOGMALITER.Skills.Name'}}</span>
      <input type="text" class="dl-grow" data-draft="name" value="{{draft.name}}" spellcheck="false"
             aria-label="{{localize 'DOGMALITER.Skills.Name'}}"/>
    </div>
    <div class="dl-row dl-row--top">
      <span class="dl-label">{{localize 'DOGMALITER.Skills.Description'}}</span>
      <textarea class="dl-grow dl-textarea" data-draft="description" rows="4"
                aria-label="{{localize 'DOGMALITER.Skills.Description'}}">{{draft.description}}</textarea>
    </div>
    <div class="dl-row">
      <span class="dl-label">{{localize 'DOGMALITER.Skills.Tags'}}</span>
      <input type="text" class="dl-grow" data-draft="tags" value="{{draft.tags}}" spellcheck="false"
             placeholder="{{localize 'DOGMALITER.Skills.TagsPlaceholder'}}" aria-label="{{localize 'DOGMALITER.Skills.Tags'}}"/>
    </div>

    <div class="dl-skill-block">
      <span class="dl-label">{{localize 'DOGMALITER.Skills.Roll'}}</span>
      <div class="dl-skill-line">
        <input type="text" class="dl-grow" data-draft="roll" value="{{draft.roll}}" spellcheck="false"
               placeholder="{{localize 'DOGMALITER.Skills.RollPlaceholder'}}" aria-label="{{localize 'DOGMALITER.Skills.Roll'}}"/>
        <label class="dl-check">
          <input type="checkbox" data-draft="askMultiplier" {{checked draft.askMultiplier}}/>
          {{localize 'DOGMALITER.Skills.AskMultiplier'}}
        </label>
      </div>
      <p class="dl-hint">{{localize 'DOGMALITER.Skills.RollHint'}}</p>
    </div>

    <div class="dl-row">
      <span class="dl-label">{{localize 'DOGMALITER.Skills.Cooldown'}}</span>
      <input type="number" class="dl-skill-number" min="0" step="1" data-draft="cooldown" value="{{draft.cooldown}}"
             aria-label="{{localize 'DOGMALITER.Skills.Cooldown'}}"/>
      <span class="dl-hint dl-grow">{{localize 'DOGMALITER.Skills.CooldownHint'}}</span>
    </div>

    <div class="dl-skill-block">
      <span class="dl-label">{{localize 'DOGMALITER.Skills.Cost'}}</span>
      {{#each draft.cost as |cost|}}
        <div class="dl-skill-line">
          <select data-draft="cost.{{cost.index}}.key" aria-label="{{localize 'DOGMALITER.Skills.Cost'}}">
            {{selectOptions @root.costChoices selected=cost.key localize=true}}
          </select>
          {{#if cost.isAttribute}}
            <input type="text" list="dl-skill-attributes" data-draft="cost.{{cost.index}}.name" value="{{cost.name}}"
                   placeholder="{{localize 'DOGMALITER.Skills.AttributeName'}}" aria-label="{{localize 'DOGMALITER.Skills.AttributeName'}}"/>
          {{/if}}
          <input type="number" class="dl-skill-number" min="0" step="1" data-draft="cost.{{cost.index}}.amount" value="{{cost.amount}}"
                 aria-label="{{localize 'DOGMALITER.Skills.Amount'}}"/>
          <button type="button" class="dl-icon-button dl-icon-button--danger" data-action="skillRowRemove" data-list="cost" data-index="{{cost.index}}"
                  aria-label="{{localize 'DOGMALITER.Skills.RemoveRow'}}"><i class="fa-solid fa-xmark" inert></i></button>
        </div>
      {{else}}
        <p class="dl-hint">{{localize 'DOGMALITER.Skills.Free'}}</p>
      {{/each}}
      <button type="button" class="dl-button dl-button--small dl-button--quiet" data-action="skillCostAdd">
        <i class="fa-solid fa-plus" inert></i> {{localize 'DOGMALITER.Skills.AddCost'}}
      </button>
    </div>

    <div class="dl-skill-block">
      <span class="dl-label">{{localize 'DOGMALITER.Skills.Requirements'}}</span>
      {{#each draft.requirements as |req|}}
        <div class="dl-skill-line">
          <input type="text" class="dl-grow" list="dl-skill-attributes" data-draft="requirements.{{req.index}}.name" value="{{req.name}}"
                 placeholder="{{localize 'DOGMALITER.Skills.AttributeName'}}" aria-label="{{localize 'DOGMALITER.Skills.AttributeName'}}"/>
          <select class="dl-skill-op" data-draft="requirements.{{req.index}}.op" aria-label="{{localize 'DOGMALITER.Skills.Op'}}">
            {{selectOptions @root.opChoices selected=req.op}}
          </select>
          <input type="number" class="dl-skill-number" step="1" data-draft="requirements.{{req.index}}.min" value="{{req.min}}"
                 aria-label="{{localize 'DOGMALITER.Skills.Min'}}"/>
          <button type="button" class="dl-icon-button dl-icon-button--danger" data-action="skillRowRemove" data-list="requirements" data-index="{{req.index}}"
                  aria-label="{{localize 'DOGMALITER.Skills.RemoveRow'}}"><i class="fa-solid fa-xmark" inert></i></button>
        </div>
      {{else}}
        <p class="dl-hint">{{localize 'DOGMALITER.Skills.NoRequirements'}}</p>
      {{/each}}
      <button type="button" class="dl-button dl-button--small dl-button--quiet" data-action="skillReqAdd">
        <i class="fa-solid fa-plus" inert></i> {{localize 'DOGMALITER.Skills.AddRequirement'}}
      </button>
    </div>

    <datalist id="dl-skill-attributes">
      {{#each attributeNames as |name|}}<option value="{{name}}"></option>{{/each}}
    </datalist>

    <div class="dl-row">
      <button type="button" class="dl-button" data-action="skillSave">
        <i class="fa-solid fa-floppy-disk" inert></i>
        {{#if draft.editing}}{{localize 'DOGMALITER.Skills.Save'}}{{else}}{{localize 'DOGMALITER.Skills.Create'}}{{/if}}
      </button>
      {{#if draft.editing}}
        <button type="button" class="dl-button dl-button--quiet" data-action="skillCancel">{{localize 'DOGMALITER.Skills.Cancel'}}</button>
      {{/if}}
    </div>
  </details>

  <div class="dl-card">
    <div class="dl-row dl-row--wrap">
      <input type="text" class="dl-search dl-grow" data-search="skills" value="{{search.skills}}" spellcheck="false"
             placeholder="{{localize 'DOGMALITER.Skills.Search'}}" aria-label="{{localize 'DOGMALITER.Panel.Search'}}"/>
      <select data-change="skillTag" aria-label="{{localize 'DOGMALITER.Skills.Tags'}}">
        <option value="">{{localize 'DOGMALITER.Skills.AllTags'}}</option>
        {{#each tagChoices as |t|}}<option value="{{t.tag}}" {{#if t.selected}}selected{{/if}}>{{t.tag}}</option>{{/each}}
      </select>
    </div>
    <p class="dl-hint">{{localize 'DOGMALITER.Skills.ListHint'}}</p>
  </div>

  <ol class="dl-skill-list" data-search-list="skills">
    {{#each skills as |skill|}}
      <li class="dl-card dl-skill {{#if skill.editing}}is-editing{{/if}}" draggable="true"
          data-skill-uuid="{{skill.uuid}}" data-search-text="{{skill.search}}" data-tags="{{skill.tagKey}}">
        <div class="dl-row">
          <i class="fa-solid fa-grip-vertical dl-muted dl-drag" inert></i>
          <img class="dl-skill-img" src="{{skill.img}}" alt=""/>
          <strong class="dl-grow">{{skill.name}}</strong>
          <button type="button" class="dl-button dl-button--small" data-action="skillGive">
            <i class="fa-solid fa-hand-holding" inert></i> {{localize 'DOGMALITER.Skills.Give'}}
          </button>
          <button type="button" class="dl-icon-button" data-action="skillEdit"
                  data-tooltip="{{localize 'DOGMALITER.Skills.Edit'}}" aria-label="{{localize 'DOGMALITER.Skills.Edit'}}">
            <i class="fa-solid fa-pen" inert></i>
          </button>
          <button type="button" class="dl-icon-button dl-icon-button--danger" data-action="skillDelete"
                  data-tooltip="{{localize 'DOGMALITER.Skills.Delete'}}" aria-label="{{localize 'DOGMALITER.Skills.Delete'}}">
            <i class="fa-solid fa-trash" inert></i>
          </button>
        </div>
        <div class="dl-skill-meta">
          {{#each skill.tags as |tag|}}<span class="dl-tag">{{tag}}</span>{{/each}}
          {{#if skill.cooldown}}<span class="dl-skill-chip"><i class="fa-solid fa-hourglass-half" inert></i> {{skill.cooldown}}</span>{{/if}}
          {{#if skill.roll}}<span class="dl-skill-chip dl-skill-chip--roll"><i class="fa-solid fa-dice-d20" inert></i> {{skill.roll}}</span>{{/if}}
          {{#each skill.costs as |cost|}}<span class="dl-skill-chip dl-skill-chip--cost"><i class="fa-solid fa-coins" inert></i> {{cost}}</span>{{/each}}
          {{#each skill.requirements as |req|}}<span class="dl-skill-chip"><i class="fa-solid fa-lock" inert></i> {{req}}</span>{{/each}}
        </div>
        {{#if skill.excerpt}}<p class="dl-hint dl-skill-excerpt">{{skill.excerpt}}</p>{{/if}}
      </li>
    {{else}}
      <li class="dl-empty">{{localize 'DOGMALITER.Skills.NoneYet'}}</li>
    {{/each}}
  </ol>
</section>
