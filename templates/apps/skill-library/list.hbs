{{!-- Skill library, main: every skill as a card. A card drags onto a character
      sheet or onto a folder on the left. --}}
<section class="dl-sl-list">
  {{#if skills.length}}
    <ol class="dl-sl-grid">
      {{#each skills as |skill|}}
        <li class="dl-sl-card" draggable="true" data-skill-uuid="{{skill.uuid}}" data-folder="{{skill.folder}}"
            data-search-text="{{skill.search}}" data-tags="{{skill.tagKey}}" data-costs="{{skill.costKey}}">
          <div class="dl-sl-card-head">
            <img class="dl-sl-card-img" src="{{skill.img}}" alt=""/>
            <a class="dl-sl-card-name" data-action="edit">{{skill.name}}</a>
          </div>
          {{#if skill.tags.length}}<div class="dl-sl-card-tags">{{#each skill.tags as |tag|}}<span class="dl-tag">{{tag}}</span>{{/each}}</div>{{/if}}
          <div class="dl-skill-meta">
            {{#if skill.roll}}<span class="dl-skill-chip dl-skill-chip--roll"><i class="fa-solid fa-dice-d20" inert></i> {{skill.roll}}</span>{{/if}}
            {{#if skill.cooldown}}<span class="dl-skill-chip"><i class="fa-solid fa-hourglass-half" inert></i> {{skill.cooldown}}</span>{{/if}}
            {{#if skill.sound}}<span class="dl-skill-chip" data-tooltip="{{skill.sound}}"><i class="fa-solid fa-volume-high" inert></i></span>{{/if}}
            {{#each skill.costs as |cost|}}<span class="dl-skill-chip dl-skill-chip--cost"><i class="fa-solid fa-coins" inert></i> {{cost}}</span>{{/each}}
            {{#each skill.requirements as |req|}}<span class="dl-skill-chip"><i class="fa-solid fa-lock" inert></i> {{req}}</span>{{/each}}
          </div>
          {{#if skill.excerpt}}<p class="dl-hint dl-sl-card-text">{{skill.excerpt}}</p>{{/if}}
          <footer class="dl-sl-card-actions">
            <button type="button" class="dl-button dl-button--small" data-action="give">
              <i class="fa-solid fa-hand-holding" inert></i> {{localize 'DOGMALITER.Skills.Give'}}
            </button>
            <button type="button" class="dl-icon-button" data-action="edit"
                    data-tooltip="{{localize 'DOGMALITER.Skills.Edit'}}" aria-label="{{localize 'DOGMALITER.Skills.Edit'}}">
              <i class="fa-solid fa-pen" inert></i>
            </button>
            <button type="button" class="dl-icon-button dl-icon-button--danger" data-action="delete"
                    data-tooltip="{{localize 'DOGMALITER.Skills.Delete'}}" aria-label="{{localize 'DOGMALITER.Skills.Delete'}}">
              <i class="fa-solid fa-trash" inert></i>
            </button>
          </footer>
        </li>
      {{/each}}
    </ol>
    <p class="dl-empty dl-sl-nothing" hidden>{{localize 'DOGMALITER.Skills.NothingFound'}}</p>
  {{else}}
    <p class="dl-empty">{{localize 'DOGMALITER.Skills.NoneYet'}}</p>
  {{/if}}
</section>
