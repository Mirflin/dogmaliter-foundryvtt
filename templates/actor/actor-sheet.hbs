{{!-- Roll20-style actor sheet: module/sheets/actor-sheet.mjs. Pages: Main, Attributes, Inventory.
      Every field saves itself on change; there is no save button. --}}
<form class="{{cssClass}} r20 flexcol" autocomplete="off">

  <header class="r20-header">
    <input class="r20-name" name="name" type="text" value="{{actor.name}}"
           placeholder="{{localize 'DOGMALITER.Sheet.NamePlaceholder'}}" spellcheck="false"/>
    {{#if editable}}
      <button type="button" class="r20-button" data-action="stat-roll">
        <i class="fas fa-dice-d20"></i> {{localize 'DOGMALITER.StatRoll.Button'}}
      </button>
      <button type="button" class="r20-button" data-action="reaction-roll">
        <i class="fas fa-shield-halved"></i> {{localize 'DOGMALITER.StatRoll.Reaction'}}
      </button>
    {{/if}}
  </header>

  {{!-- Resources: health, mana, AP. Each can be switched off (the checkbox);
        the selects say who sees its bar above the token, and the number on it. --}}
  <section class="r20-resources">
    {{#each resources as |res|}}
      <div class="r20-resource {{#unless res.enabled}}is-off{{/unless}}" data-resource="{{res.key}}"
           style="--r20-resource-color: {{res.color}}">
        <div class="r20-resource-head">
          {{#if @root.editable}}
            <label class="r20-resource-toggle" data-tooltip="{{localize 'DOGMALITER.Sheet.ResourceEnabled'}}">
              <input type="checkbox" name="system.{{res.key}}.enabled" {{checked res.enabled}}/>
              <span class="r20-label">{{localize res.label}}</span>
            </label>
          {{else}}
            <span class="r20-label">{{localize res.label}}</span>
          {{/if}}
        </div>
        {{#if res.enabled}}
          <div class="r20-resource-values">
            <input type="number" name="system.{{res.key}}.value" value="{{res.value}}" data-dtype="Number" step="any"
                   aria-label="{{localize res.label}}" {{#unless @root.editable}}disabled{{/unless}}/>
            <span class="r20-attr-slash" aria-hidden="true">/</span>
            <input type="number" name="system.{{res.key}}.max" value="{{res.max}}" data-dtype="Number" step="any"
                   aria-label="{{localize 'DOGMALITER.Sheet.AttributeMax'}}" {{#unless @root.editable}}disabled{{/unless}}/>
          </div>
          <div class="r20-resource-bar"><span style="width: {{res.pct}}%"></span></div>
          {{#if @root.editable}}
            <label class="r20-resource-view" data-tooltip="{{localize 'DOGMALITER.Sheet.ShowBarHint'}}">
              <i class="fas fa-bars-progress" aria-hidden="true"></i>
              <select name="system.{{res.key}}.showBar" aria-label="{{localize 'DOGMALITER.Sheet.ShowBar'}}">
                {{selectOptions @root.viewerChoices selected=res.showBar localize=true}}
              </select>
            </label>
            <label class="r20-resource-view" data-tooltip="{{localize 'DOGMALITER.Sheet.ShowValueHint'}}">
              <i class="fas fa-hashtag" aria-hidden="true"></i>
              <select name="system.{{res.key}}.showValue" aria-label="{{localize 'DOGMALITER.Sheet.ShowValue'}}">
                {{selectOptions @root.viewerChoices selected=res.showValue localize=true}}
              </select>
            </label>
          {{/if}}
        {{/if}}
      </div>
    {{/each}}
  </section>

  <nav class="sheet-tabs tabs r20-tabs" data-group="primary">
    <a class="item" data-tab="main">{{localize 'DOGMALITER.Sheet.TabMain'}}</a>
    <a class="item" data-tab="attributes">{{localize 'DOGMALITER.Sheet.TabAttributes'}}</a>
    <a class="item" data-tab="inventory">{{localize 'DOGMALITER.Sheet.TabInventory'}}</a>
    <a class="item" data-tab="skills">{{localize 'DOGMALITER.Sheet.TabSkills'}}</a>
  </nav>

  <section class="sheet-body r20-body">

    {{!-- Main: portrait, token, description --}}
    <div class="tab r20-main" data-group="primary" data-tab="main">
      <div class="r20-images">
        {{!-- Each slot: the picture (click to change, x to remove), or, with
              none yet, a dashed empty slot with a "+" that opens the picker. --}}
        <figure class="r20-image">
          <figcaption class="r20-label">{{localize 'DOGMALITER.Sheet.Portrait'}}</figcaption>
          {{#if portrait}}
            <div class="r20-image-frame">
              <img src="{{portrait}}" data-edit="img" alt="{{localize 'DOGMALITER.Sheet.Portrait'}}"
                   {{#if editable}}title="{{localize 'DOGMALITER.Sheet.ClickToChange'}}"{{/if}}/>
              {{#if editable}}
                <button type="button" class="r20-image-remove" data-action="image-remove" data-field="img"
                        title="{{localize 'DOGMALITER.Sheet.RemoveImage'}}"
                        aria-label="{{localize 'DOGMALITER.Sheet.RemoveImage'}}"><i class="fas fa-xmark"></i></button>
              {{/if}}
            </div>
            {{#if editable}}<p class="r20-hint">{{localize 'DOGMALITER.Sheet.ClickToChange'}}</p>{{/if}}
          {{else if editable}}
            <button type="button" class="r20-image-empty" data-action="image-pick" data-field="img"
                    title="{{localize 'DOGMALITER.Sheet.AddPortrait'}}"
                    aria-label="{{localize 'DOGMALITER.Sheet.AddPortrait'}}"><i class="fas fa-plus"></i></button>
            <p class="r20-hint">{{localize 'DOGMALITER.Sheet.AddPortrait'}}</p>
          {{else}}
            <div class="r20-image-empty is-static"></div>
          {{/if}}
        </figure>

        <figure class="r20-image">
          <figcaption class="r20-label">{{localize 'DOGMALITER.Sheet.Token'}}</figcaption>
          {{#if token}}
            <div class="r20-image-frame r20-image-frame--token">
              <img src="{{token}}" data-edit="prototypeToken.texture.src" alt="{{localize 'DOGMALITER.Sheet.Token'}}"
                   {{#if editable}}title="{{localize 'DOGMALITER.Sheet.ClickToChange'}}"{{/if}}/>
              {{#if editable}}
                <button type="button" class="r20-image-remove" data-action="image-remove" data-field="prototypeToken.texture.src"
                        title="{{localize 'DOGMALITER.Sheet.RemoveImage'}}"
                        aria-label="{{localize 'DOGMALITER.Sheet.RemoveImage'}}"><i class="fas fa-xmark"></i></button>
              {{/if}}
            </div>
          {{else if editable}}
            <button type="button" class="r20-image-empty r20-image-empty--token" data-action="image-pick"
                    data-field="prototypeToken.texture.src"
                    title="{{localize 'DOGMALITER.Sheet.AddToken'}}"
                    aria-label="{{localize 'DOGMALITER.Sheet.AddToken'}}"><i class="fas fa-plus"></i></button>
            <p class="r20-hint">{{localize 'DOGMALITER.Sheet.AddToken'}}</p>
          {{else}}
            <div class="r20-image-empty r20-image-empty--token is-static"></div>
          {{/if}}
          {{#if editable}}{{#if portrait}}
            <button type="button" class="r20-button r20-button--small" data-action="token-from-portrait">
              {{localize 'DOGMALITER.Sheet.UsePortrait'}}
            </button>
          {{/if}}{{/if}}
        </figure>
      </div>

      <div class="r20-description">
        <p class="r20-label">{{localize 'DOGMALITER.Sheet.Description'}}
          {{#if editable}}<span class="r20-label-note">{{localize 'DOGMALITER.Sheet.DescriptionSaveHint'}}</span>{{/if}}
        </p>
        {{!-- Foundry's ProseMirror editor, always open (button=false): fonts,
              sizes, colours, alignment, headings, lists, tables, images. --}}
        {{editor enrichedDescription target="system.biography" button=false editable=editable engine="prosemirror"}}
      </div>
    </div>

    {{!-- Attributes: a list the player builds --}}
    <div class="tab r20-attributes" data-group="primary" data-tab="attributes">
      <div class="r20-attr-row r20-attr-headings">
        <span>{{localize 'DOGMALITER.Sheet.AttributeName'}}</span>
        <span>{{localize 'DOGMALITER.Sheet.AttributeCurrent'}}</span>
        <span>{{localize 'DOGMALITER.Sheet.AttributeMax'}}</span>
        <span title="{{localize 'DOGMALITER.Sheet.InRollsHint'}}">{{localize 'DOGMALITER.Sheet.InRolls'}}</span>
        <span></span>
      </div>

      <ol class="r20-attr-list">
        {{#each attributes as |attr|}}
          <li class="r20-attr-row" data-attribute-id="{{attr.id}}">
            <input type="text" name="system.attributes.{{attr.id}}.name" value="{{attr.name}}"
                   placeholder="{{localize 'DOGMALITER.Sheet.AttributeName'}}" spellcheck="false"/>
            <input type="text" name="system.attributes.{{attr.id}}.value" value="{{attr.value}}"
                   placeholder="{{localize 'DOGMALITER.Sheet.AttributeCurrent'}}" data-dtype="String" spellcheck="false"/>
            <div class="r20-attr-max">
              <span class="r20-attr-slash" aria-hidden="true">/</span>
              <input type="text" name="system.attributes.{{attr.id}}.max" value="{{attr.max}}"
                     placeholder="{{localize 'DOGMALITER.Sheet.AttributeMax'}}" data-dtype="String" spellcheck="false"/>
            </div>
            <code class="r20-attr-key" title="{{localize 'DOGMALITER.Sheet.InRollsHint'}}">{{#if attr.key}}@{{attr.key}}{{#if attr.max}}<br/><span>@{{attr.key}}_max</span>{{/if}}{{else}}&mdash;{{/if}}</code>
            {{#if @root.editable}}
              <button type="button" class="r20-icon-button" data-action="attribute-delete"
                      title="{{localize 'DOGMALITER.Sheet.DeleteAttribute'}}"
                      aria-label="{{localize 'DOGMALITER.Sheet.DeleteAttribute'}}"><i class="fas fa-trash"></i></button>
            {{else}}<span></span>{{/if}}
          </li>
        {{else}}
          <li class="r20-empty">{{localize 'DOGMALITER.Sheet.NoAttributes'}}</li>
        {{/each}}
      </ol>

      {{#if editable}}
        <button type="button" class="r20-button" data-action="attribute-add">
          <i class="fas fa-plus"></i> {{localize 'DOGMALITER.Sheet.AddAttribute'}}
        </button>
      {{/if}}
    </div>

    {{!-- Inventory: every item the actor carries --}}
    <div class="tab r20-inventory" data-group="primary" data-tab="inventory">
      <div class="r20-inv-row r20-inv-headings">
        <span></span>
        <span>{{localize 'DOGMALITER.Sheet.InventoryItem'}}</span>
        <span>{{localize 'DOGMALITER.Sheet.InventoryQuantity'}}</span>
        <span></span>
      </div>

      <ol class="r20-inv-list">
        {{#each inventory as |item|}}
          <li class="r20-inv-row" data-item-id="{{item.id}}">
            <img class="r20-inv-img" src="{{item.img}}" alt="" data-action="item-open"/>
            <a class="r20-inv-name" data-action="item-open">
              {{item.name}}
              <span class="r20-inv-type">{{item.typeLabel}}</span>
            </a>
            <span class="r20-inv-qty">{{#if item.hasQuantity}}{{item.quantity}}{{else}}&mdash;{{/if}}</span>
            <span class="r20-inv-controls">
              {{#if @root.editable}}
                <button type="button" class="r20-icon-button r20-icon-button--send" data-action="item-send"
                        title="{{localize 'DOGMALITER.Sheet.SendItem'}}"
                        aria-label="{{localize 'DOGMALITER.Sheet.SendItem'}}"><i class="fas fa-paper-plane"></i></button>
                <button type="button" class="r20-icon-button" data-action="item-delete"
                        title="{{localize 'DOGMALITER.Sheet.DeleteItem'}}"
                        aria-label="{{localize 'DOGMALITER.Sheet.DeleteItem'}}"><i class="fas fa-trash"></i></button>
              {{/if}}
            </span>
          </li>
        {{else}}
          <li class="r20-empty">{{localize 'DOGMALITER.Sheet.NoItems'}}</li>
        {{/each}}
      </ol>
    </div>

    {{!-- Skills: module/rules/skills.mjs --}}
    <div class="tab r20-skills" data-group="primary" data-tab="skills">
      {{#if skills.length}}
        <div class="r20-skill-tools">
          <input type="text" data-skill-search value="{{skillSearch}}" spellcheck="false"
                 placeholder="{{localize 'DOGMALITER.Skills.Search'}}" aria-label="{{localize 'DOGMALITER.Skills.Search'}}"/>
          <select data-skill-tag aria-label="{{localize 'DOGMALITER.Skills.Tags'}}">
            <option value="">{{localize 'DOGMALITER.Skills.AllTags'}}</option>
            {{#each skillTags as |t|}}<option value="{{t.tag}}" {{#if t.selected}}selected{{/if}}>{{t.tag}}</option>{{/each}}
          </select>
        </div>
      {{/if}}
      <ol class="r20-skill-list">
        {{#each skills as |skill|}}
          <li class="r20-skill {{#unless skill.canUse}}is-blocked{{/unless}}" data-item-id="{{skill.id}}"
              data-search-text="{{skill.search}}" data-tags="{{skill.tagKey}}">
            <div class="r20-skill-head">
              <img class="r20-inv-img" src="{{skill.img}}" alt="" data-action="item-open"/>
              <a class="r20-skill-name" data-action="item-open">{{skill.name}}</a>
              <span class="r20-skill-tags">{{#each skill.tags as |tag|}}<span>{{tag}}</span>{{/each}}</span>
              {{#if @root.editable}}
                <button type="button" class="r20-button r20-button--small" data-action="skill-use"
                        {{#unless skill.canUse}}disabled{{/unless}}>
                  <i class="fas fa-bolt"></i> {{localize 'DOGMALITER.Skills.Use'}}
                </button>
                <button type="button" class="r20-icon-button" data-action="item-delete"
                        title="{{localize 'DOGMALITER.Skills.Remove'}}"
                        aria-label="{{localize 'DOGMALITER.Skills.Remove'}}"><i class="fas fa-trash"></i></button>
              {{/if}}
            </div>
            {{#if (or skill.costs.length skill.requirements.length skill.roll skill.cooldownLabel)}}
              <div class="r20-skill-meta">
                {{#if skill.cooldown}}<span class="r20-chip is-bad"><i class="fas fa-hourglass-half"></i> {{localize 'DOGMALITER.Skills.CooldownLeft'}}: {{skill.cooldown}}</span>
                {{else if skill.cooldownLabel}}<span class="r20-chip"><i class="fas fa-hourglass-half"></i> {{skill.cooldownLabel}}</span>{{/if}}
                {{#if skill.roll}}<span class="r20-chip r20-chip--roll"><i class="fas fa-dice-d20"></i> {{skill.roll}}</span>{{/if}}
                {{#if skill.costs.length}}
                  <span class="r20-label">{{localize 'DOGMALITER.Skills.Cost'}}</span>
                  {{#each skill.costs as |cost|}}<span class="r20-chip {{#unless cost.ok}}is-bad{{/unless}}">{{cost.label}}</span>{{/each}}
                {{/if}}
                {{#if skill.requirements.length}}
                  <span class="r20-label">{{localize 'DOGMALITER.Skills.Requirements'}}</span>
                  {{#each skill.requirements as |req|}}
                    <span class="r20-chip {{#if req.met}}is-good{{else}}is-bad{{/if}}">{{req.label}}{{#unless req.met}} ({{#if (ne req.value null)}}{{req.value}}{{else}}—{{/if}}){{/unless}}</span>
                  {{/each}}
                {{/if}}
              </div>
            {{/if}}
            {{#if skill.description}}
              <details class="r20-skill-text">
                <summary>{{localize 'DOGMALITER.Skills.Description'}}</summary>
                <div>{{{skill.description}}}</div>
              </details>
            {{/if}}
          </li>
        {{else}}
          <li class="r20-empty">{{localize 'DOGMALITER.Skills.NoneOnSheet'}}</li>
        {{/each}}
      </ol>
    </div>

  </section>
</form>
