{{!-- The stat check's chat card: module/rolls/stat-roll.mjs. --}}
<div class="dice-roll">
  <h3>{{abilityName}} — {{actorName}}</h3>

  {{#if isAttack}}
    <p><strong>{{localize 'DOGMALITER.StatRoll.Attack'}}:</strong> {{attackName}}</p>
    <p><strong>{{localize 'DOGMALITER.StatRoll.AttackMultiplierShort'}}:</strong> {{attackMultiplier}}</p>
    <p><strong>{{localize 'DOGMALITER.StatRoll.Distance'}}:</strong> <span style="{{distanceStyle}}">{{distanceLabel}}</span></p>
  {{/if}}

  {{#if isCrit}}
    <p><strong>{{fencingName}}: </strong><strong style="color: green;">{{localize 'DOGMALITER.StatRoll.Crit'}}</strong></p>
  {{/if}}

  <div class="dice-result">
    <div class="dice-formula">
      ( (<span style="{{dieStyle}}"> {{die}} </span> + {{multiplier}} ) / 10 ) × {{statValue}}
    </div>
    <h4 class="dice-total"><span style="{{dieStyle}}">{{result}}</span></h4>
  </div>

  <p><strong>{{localize 'DOGMALITER.StatRoll.Ability'}}:</strong> {{abilityName}} ({{statValue}})</p>
  <p><strong>{{localize 'DOGMALITER.StatRoll.Die'}}:</strong> {{die}}</p>
  <p><strong>{{localize 'DOGMALITER.StatRoll.AbilityMultiplier'}}:</strong> {{multiplier}}</p>
</div>
