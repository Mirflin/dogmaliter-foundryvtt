{{!-- The stat check dialog: module/rolls/stat-roll.mjs. The attack fields are
      dimmed until "Attack" is ticked (CSS only: .dl-stat-roll in _gm-panel.scss). --}}
<div class="dl-stat-roll">
  <div class="form-group">
    <label class="dl-stat-roll-check">
      <input type="checkbox" name="isAttack" {{#unless attacks.length}}disabled{{/unless}}/>
      {{localize 'DOGMALITER.StatRoll.Attack'}}
    </label>
    {{#unless attacks.length}}<p class="hint">{{localize 'DOGMALITER.StatRoll.NoAttacks'}}</p>{{/unless}}
  </div>

  <div class="form-group dl-stat-roll-attack">
    <label>{{localize 'DOGMALITER.StatRoll.AttackType'}}</label>
    <select name="attackType">
      {{#each attacks as |attack|}}
        <option value="{{attack.id}}">{{attack.name}} ({{attack.value}})</option>
      {{/each}}
    </select>
  </div>

  <div class="form-group dl-stat-roll-attack">
    <label>{{localize 'DOGMALITER.StatRoll.AttackMultiplier'}}</label>
    <input type="number" name="attackMultiplier" value="0" step="any"/>
  </div>

  <div class="form-group">
    <label>{{localize 'DOGMALITER.StatRoll.Ability'}}</label>
    <select name="ability">
      {{#each stats as |stat|}}
        <option value="{{stat.id}}">{{stat.name}} ({{stat.value}})</option>
      {{/each}}
    </select>
  </div>

  <div class="form-group">
    <label>{{localize 'DOGMALITER.StatRoll.AbilityMultiplier'}}</label>
    <input type="number" name="multiplier" value="0" step="any" autofocus/>
  </div>
</div>
